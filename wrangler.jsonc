// Cloudflare Workers Builds: publica la web de Alejandro con el formulario guardando en D1.
// Para otra persona: crear otro Worker con su propia configuración (cambiar name, build y assets).
{
  "name": "kangen-team",
  "main": "compartido/api/worker-cloudflare.ts",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build -w sitio-alejandro"
  },
  "assets": {
    "directory": "./equipo/alejandro/sitio/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Vistas previas de cada rama (wrangler preview): base de datos aparte para no mezclar
  // contactos de prueba con los reales.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "leads-equipo-preview",
        "database_id": "00c7311f-1d77-4d5a-ae6c-2e9a6d1a1ba1"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leads-equipo",
      "database_id": "61d1a63c-6910-4e2d-9f64-e36b8d15cfb7"
    }
  ]
}
